# 1. Global defaults: Auto-detect text files and force LF line endings (equivalent to "core.autocrlf=input")
* text=auto eol=lf

# 2. Windows-specific exception: Force CRLF for batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# 3. Python-specific configurations (inspired by https://github.com/gitattributes/gitattributes/blob/master/Python.gitattributes)

# Source files
# ============
*.pxd    text diff=python
*.py     text diff=python
*.py3    text diff=python
*.pyw    text diff=python
*.pyx    text diff=python
*.pyz    text diff=python
*.pyi    text diff=python

# Binary files
# ============
*.db     binary
*.p      binary
*.pkl    binary
*.pickle binary
*.npy    binary
*.pyc    binary export-ignore
*.pyo    binary export-ignore
*.pyd    binary

# Jupyter notebook
*.ipynb  text eol=lf

# Note: .db, .p, and .pkl files are associated
# with the python modules ``pickle``, ``dbm.*``,
# ``shelve``, ``marshal``, ``anydbm``, & ``bsddb``
# (among others).

# 4. Ensure shared libraries and executables are treated as binary
*.so binary
*.dll binary
*.exe binary

# 5. Web and Data formats (Optional but recommended)
# Treat common data/frontend files as text for better diffs
*.json text
*.yaml text
*.yml text
*.md text
*.sql text
*.html text
*.css text

# 6. Asset handling
# Explicitly mark images and archives as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar.gz binary
